   "call_seq": 5,
   "statement": "The blobctl migration script needs the env var STORAGE_ENV=staging."
  },
  {
   "session_id": "fx-scr-b03",
   "idx": 0,
   "call_seq": 5,
   "statement": "Setting STORAGE_ENV=staging is required before running blobctl plan."
  },
  {
   "session_id": "fx-scr-b04",
   "idx": 0,
   "call_seq": 5,
   "statement": "blobctl exits with status 2 when STORAGE_ENV is missing; use STORAGE_ENV=staging."
  },
  {
   "session_id": "fx-scr-b05",
   "idx": 0,
   "call_seq": 5,
   "statement": "Tidewater blobctl commands only run with STORAGE_ENV=staging in the environment."
  },
  {
   "session_id": "fx-scr-07",
   "idx": 0,
   "call_seq": 5,
   "statement": "Without STORAGE_ENV=staging, blobctl refuses to plan against the bucket."
