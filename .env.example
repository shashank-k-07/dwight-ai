# Copy to .env (repo root). backend/dwight/config.py loads it; real env vars win.

# --- GLM (via Sciforium, OpenAI-compatible). Only needed by stages that call GLM. ---
SCIFORIUM_API_KEY=             # team key (DWIGHT_GLM_API_KEY also works)
DWIGHT_GLM_BASE_URL=https://api.sciforium.com/v1
# Model strings below are placeholders: list the real ones with
#   curl https://api.sciforium.com/v1/models -H "Authorization: Bearer $SCIFORIUM_API_KEY"
DWIGHT_GLM_TIER=standard       # default tier for Dwight's own GLM calls: flagship | standard | light
DWIGHT_GLM_MODEL_FLAGSHIP=/deployments/506a9a37/deepseek-ai/DeepSeek-V4.1-Flash
DWIGHT_GLM_MODEL_STANDARD=/deployments/506a9a37/deepseek-ai/DeepSeek-V4.1-Flash
DWIGHT_GLM_MODEL_LIGHT=/deployments/506a9a37/deepseek-ai/DeepSeek-V4.1-Flash
# Dwight's own calls round-robin over these (add GLM 5.3 Flash once its model string is known)
DWIGHT_GLM_MODEL_POOL=/deployments/506a9a37/deepseek-ai/DeepSeek-V4.1-Flash
DWIGHT_GLM_EMBED_MODEL=embedding-3
# DWIGHT_GLM_THINKING=disabled # Z.ai-only field; leave unset unless the provider accepts it

# --- Store / paths (defaults are repo-relative) ---
# DWIGHT_DB=backend/var/dwight.sqlite
# DWIGHT_PRICES=data/prices.yaml
# DWIGHT_OUT_DIR=out
DWIGHT_FORCE_FIXTURES=0        # 1 = every API endpoint serves fixture JSON

# --- Dashboard ---
DWIGHT_API_URL=http://localhost:8000   # API base URL the dashboard proxies /api/* to
